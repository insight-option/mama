# Copy to .env.local for local development. Example names only — never commit real secrets.

# Canonical public URL (used for SEO metadata, sitemap, hreflang). Set once a verified domain exists.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Fontaine WhatsApp recipient: international digits only, no "+" or spaces (e.g. 974XXXXXXXX).
# While empty, the WhatsApp button falls back to copying the plan.
NEXT_PUBLIC_WHATSAPP_NUMBER=""

